  "DEFINITION": {
    "AUTHORITATIVE_WHOLE_ROBOT_DESCRIPTION": "the vendor-supplied robot-description source that the production M3 Pro software actually uses to publish robot_description for the physical whole-robot configuration",
    "decided_by": "the production execution and reference chain",
    "explicitly_not_decided_by": [
      "filename",
      "completeness",
      "which file parses most cleanly",
      "which model is easiest to import",
      "mesh quality",
      "which model best fits our intended simulator",
      "recency"
    ],
    "why": "every one of those is a way to end up simulating a robot the vendor does not ship",
    "frozen_before_candidates_were_scored": true
  },
  "DECISION_RULES": [
    "A. exactly one candidate reached by the production bringup chain and passed to robot_state_publisher takes WHOLE_ROBOT_RUNTIME_AUTHORITY",
    "B. a candidate reached only through manipulator tooling takes MANIPULATOR_PLANNING_AUTHORITY when it defines planning semantics of its own, otherwise SUPPORTING_COMPONENT_SOURCE",
    "C. two candidates loaded as competing roots in the same production configuration make the decision AMBIGUOUS and it stops",
    "D. no candidate is preferred for being newer, more complete, cleaner or easier to simulate; none of those is an input to this function"
  ],
