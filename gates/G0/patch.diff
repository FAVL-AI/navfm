@@ -18,6 +18,43 @@ from vint_train.data.data_utils import (
     to_local_coords,
 )
 
+# # navfm-patch:sampling_rng_isolation -- goal sampling drew from the GLOBAL
+# numpy stream, so seeding a model also changed which (observation, goal)
+# pairs were scored: model identity and evaluation population were coupled
+# through one RNG. They are separate experimental factors and now use
+# separate streams. This RandomState is navfm-controlled and is seeded by
+# navfm_seed_sampling() from a declared population seed; global np.random
+# no longer influences which pairs are drawn.
+_NAVFM_SAMPLING_RNG = np.random.RandomState()
+
+#: Every (obs_traj, obs_t, goal_traj, goal_t) actually drawn, in draw order.
+#: Read by navfm.evalpairs to verify the realised population against the
+#: pinned manifest -- observed, not reconstructed from a seed.
+_NAVFM_REALISED_PAIRS = []
+
+
+def navfm_normalise_traj_data(traj_data, trajectory_name):
+    """Make a released trajectory satisfy the model-ready contract (F13).
+
+    The released GO Stanford corpus stores position and yaw as object-dtype
+    arrays -- position of 0-d float64 scalars, yaw of 1-element ndarrays --
+    which torch.as_tensor rejects under every numpy version regardless of
+    what is boxed. navfm.trajio is the single boundary that converts them,
+    and it
+    ASSERTS rather than repairs: exactly one scalar per cell or refuse,
+    correct shape or refuse, finite or refuse, never truncate, never drop.
+    """
+    from navfm.trajio import normalise_traj_data
+
+    return normalise_traj_data(traj_data, trajectory=trajectory_name)
+
+
+def navfm_seed_sampling(seed):
+    """Seed the evaluation-population stream. Independent of model init."""
+    _NAVFM_SAMPLING_RNG.seed(seed)
+    _NAVFM_REALISED_PAIRS.clear()
+
+
 class ViNT_Dataset(Dataset):
     def __init__(
         self,
