+        goal_offset = _NAVFM_SAMPLING_RNG.randint(0, max_goal_dist + 1)  # navfm-patch:sampling_rng_goal_offset
         if goal_offset == 0:
             trajectory_name, goal_time = self._sample_negative()
             return trajectory_name, goal_time, True
@@ -204,7 +241,7 @@ class ViNT_Dataset(Dataset):
         """
         Sample a goal from a (likely) different trajectory.
         """
-        return self.goals_index[np.random.randint(0, len(self.goals_index))]
+        return self.goals_index[_NAVFM_SAMPLING_RNG.randint(0, len(self.goals_index))]  # navfm-patch:sampling_rng_negative
 
     def _load_index(self) -> None:
         """
@@ -279,6 +316,7 @@ class ViNT_Dataset(Dataset):
         else:
             with open(os.path.join(self.data_folder, trajectory_name, "traj_data.pkl"), "rb") as f:
                 traj_data = pickle.load(f)
+            traj_data = navfm_normalise_traj_data(traj_data, trajectory_name)  # navfm-patch:contract_normalisation_call
